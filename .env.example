# Copy this file to .env.local and fill in values. Never commit .env.local.
# See docs/vercel-environment-variables.md for what each line means.

# --- Database (required) ---
DATABASE_URL=

# Neon: set to 1 if DATABASE_URL points at Neon
# PRISMA_USE_NEON=1
# DATABASE_POOL_MAX=5

# --- Clerk (required) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional overrides (defaults are set in src/app/providers.tsx)
# NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
# NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# --- App URL (required in production — use your Vercel URL) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Vercel Blob — logo uploads (Settings → Branding) ---
BLOB_READ_WRITE_TOKEN=

# --- Resend — “Send email” on leads ---
RESEND_API_KEY=
RESEND_FROM="Lendex <onboarding@resend.dev>"
EMAIL_REPLY_TO=

# --- reCAPTCHA (embed / lead form; optional) ---
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# NEXT_PUBLIC_RECAPTCHA_VERSION=v2

# --- Cloudflare Turnstile (optional alternative to reCAPTCHA) ---
# TURNSTILE_SECRET_KEY=

# --- Upstash Redis — rate limits (optional) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Stripe (optional) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
