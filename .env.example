# Vercel Blob (https://vercel.com/docs/storage/vercel-blob) — required for logo uploads on Settings → Branding
BLOB_READ_WRITE_TOKEN=

# Resend (https://resend.com) — required for “Send email” on lead pages
RESEND_API_KEY=

# Verified sender, e.g. "Acme Brokerage <mail@yourdomain.com>" (must match a verified domain in Resend)
RESEND_FROM="Lendex <onboarding@resend.dev>"

# Optional workspace fallback when a user has not set a personal Reply-To under Settings → Email
EMAIL_REPLY_TO=you@yourdomain.com
